<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <title>ImgFast - Admin Panel</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #09090b;
            color: #f4f4f9;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }
        
        /* Sidebar */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 240px;
            background: #121216;
            border-right: 1px solid #27272d;
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 10;
        }
        .sidebar-logo {
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 32px;
            padding: 0 8px;
        }
        .sidebar-logo span {
            background: linear-gradient(135deg, #6366f1, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .sidebar-menu { list-style: none; }
        .sidebar-menu li { margin-bottom: 4px; }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            color: #a1a1aa;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .sidebar-menu a:hover, .sidebar-menu a.active {
            background: #1a1a20;
            color: #f4f4f9;
        }
        .sidebar-menu a.active { color: #6366f1; }
        .sidebar-footer {
            position: absolute;
            bottom: 16px;
            left: 16px;
            right: 16px;
        }
        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            color: #ef4444;
            text-decoration: none;
            font-size: 0.8rem;
            transition: background 0.2s;
        }
        .sidebar-footer a:hover { background: rgba(239,68,68,0.1); }

        /* Main */
        .main-content {
            margin-left: 240px;
            padding: 24px 32px;
        }
        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 24px;
        }

        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: #121216;
            border: 1px solid #27272d;
            border-radius: 14px;
            padding: 20px;
        }
        .stat-card .stat-label {
            font-size: 0.7rem;
            color: #71717a;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .stat-card .stat-value {
            font-size: 1.8rem;
            font-weight: 800;
            color: #6366f1;
        }

        /* Table */
        .table-container {
            background: #121216;
            border: 1px solid #27272d;
            border-radius: 14px;
            overflow: hidden;
        }
        .table-header {
            padding: 16px 20px;
            border-bottom: 1px solid #27272d;
            font-weight: 700;
            font-size: 0.9rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 12px 20px;
            text-align: left;
            font-size: 0.8rem;
        }
        th {
            background: #0d0d11;
            color: #71717a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.7rem;
        }
        td {
            border-top: 1px solid #1a1a20;
            color: #a1a1aa;
        }
        tr:hover td { background: #1a1a20; }
        
        .badge {
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
        }
        .badge-success { background: rgba(34,197,94,0.15); color: #22c55e; }
        .badge-info { background: rgba(99,102,241,0.15); color: #6366f1; }
        .badge-warning { background: rgba(245,158,11,0.15); color: #f59e0b; }
        
        .btn-sm {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: opacity 0.2s;
        }
        .btn-sm:active { opacity: 0.7; }
        .btn-danger { background: rgba(239,68,68,0.15); color: #ef4444; }
        .btn-primary { background: #6366f1; color: #fff; }

        @media (max-width: 768px) {
            .sidebar { display: none; }
            .main-content { margin-left: 0; padding: 16px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">Img<span>Fast</span> Admin</div>
        <ul class="sidebar-menu">
            <li><a href="/admin" class="active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
            </a></li>
            <li><a href="/admin/images">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                Tüm Resimler
            </a></li>
            <li><a href="<%= siteUrl %>" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Siteyi Gör
            </a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/admin/logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Çıkış Yap
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <h1 class="page-title">📊 Dashboard</h1>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Toplam Resim</div>
                <div class="stat-value"><%= stats.totalImages %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Toplam Görüntülenme</div>
                <div class="stat-value"><%= stats.totalViews %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Toplam Yorum</div>
                <div class="stat-value"><%= stats.totalComments %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Depolama</div>
                <div class="stat-value"><%= (stats.storageUsed / 1048576).toFixed(1) %> MB</div>
            </div>
        </div>

        <!-- Son Yüklenenler -->
        <div class="table-container">
            <div class="table-header">Son Yüklenen Resimler</div>
            <table>
                <thead>
                    <tr>
                        <th>Resim</th>
                        <th>Dosya Adı</th>
                        <th>Görüntülenme</th>
                        <th>Yorum</th>
                        <th>Tarih</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <% recentImages.forEach(function(img) { %>
                    <tr>
                        <td>
                            <a href="<%= img.shortUrl %>" target="_blank">
                                <img src="<%= img.url %>" alt="<%= img.originalName %>" style="width:40px;height:40px;object-fit:cover;border-radius:6px;">
                            </a>
                        </td>
                        <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= img.originalName %>">
                            <%= img.originalName %>
                        </td>
                        <td>
                            <span class="badge badge-info"><%= viewCounts.get(img.key) || 0 %></span>
                        </td>
                        <td>
                            <span class="badge badge-success"><%= (comments.get(img.key) || []).length %></span>
                        </td>
                        <td><%= new Date(img.uploadedAt).toLocaleDateString('tr-TR') %></td>
                        <td>
                            <a href="/admin/delete/<%= img.key %>" class="btn-sm btn-danger" onclick="return confirm('Emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

    </main>

</body>
</html>
