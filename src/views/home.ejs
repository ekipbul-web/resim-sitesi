<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="description" content="ImgFast - Ücretsiz, hızlı ve güvenli resim yükleme.">
    <meta name="theme-color" content="#09090b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="stylesheet" href="/css/style.css">
    <title>ImgFast - Hızlı Resim Yükleme</title>
</head>
<body>

    <div class="page-loader" id="pageLoader">
        <div class="loader-logo">
            <img src="/logo.png" alt="ImgFast" width="60" height="60" style="border-radius:14px;">
        </div>
        <div class="loader-bar">
            <div class="loader-bar-fill"></div>
        </div>
    </div>

    <button class="theme-toggle" id="themeToggle" aria-label="Tema değiştir">
        <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
    </button>

    <main class="main-container">
        
        <header class="header">
            <div class="logo">
                <img src="/logo.png" alt="ImgFast" width="48" height="48" style="border-radius:12px;">
            </div>
            <h1>Img<span>Fast</span></h1>
            <p class="tagline">Sürükle, bırak, paylaş</p>
        </header>

        <div class="upload-card" id="uploadCard">
            
            <div class="upload-zone" id="dropZone">
                <div class="icon-wrapper">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <h3>Resim Yüklemek İçin Dokun</h3>
                <p>veya <span>dosya seç</span> · CTRL+V ile yapıştır · Max 10 MB</p>
            </div>

            <input type="file" id="fileInput" accept="image/*">

            <div class="preview-area" id="previewArea">
                <img id="previewImg" src="" alt="Önizleme">
                <div class="preview-bar">
                    <span id="previewInfo"></span>
                    <button type="button" class="btn-text" id="removeBtn">Kaldır</button>
                </div>
            </div>

            <button type="button" class="btn-primary" id="uploadBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <polyline points="19 12 12 19 5 12"/>
                </svg>
                Yükle
            </button>

            <div class="loading-area" id="loadingArea">
                <div class="loader"></div>
                <p>Resim optimize ediliyor ve yükleniyor...</p>
            </div>

            <div class="error-area" id="errorArea"></div>
        </div>

        <div class="result-area" id="resultArea">
            <div class="result-card">
                <img id="resultImg" src="" alt="Yüklenen resim">
                <div class="result-body">
                    <h4>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Yükleme Başarılı
                    </h4>

                    <div class="file-info-card">
                        <div class="file-info-row">
                            <span class="file-info-label">Dosya Adı</span>
                            <span class="file-info-value" id="resultFileName">-</span>
                        </div>
                        <div class="file-info-row">
                            <span class="file-info-label">Dosya Türü</span>
                            <span class="file-info-value">
                                <span id="resultFileBadge" class="file-type-badge">-</span>
                            </span>
                        </div>
                        <div class="file-info-row">
                            <span class="file-info-label">Orijinal</span>
                            <span class="file-info-value" id="resultOriginalSize">-</span>
                        </div>
                        <div class="file-info-row">
                            <span class="file-info-label">Optimize</span>
                            <span class="file-info-value" id="resultOptimizedSize">-</span>
                        </div>
                        <div class="file-info-row">
                            <span class="file-info-label">Tasarruf</span>
                            <span class="file-info-value" id="resultSavings">-</span>
                        </div>
                        <div class="file-info-row">
                            <span class="file-info-label">Görüntülenme</span>
                            <span class="file-info-value" id="resultViews">0</span>
                        </div>
                    </div>

                    <div class="exif-section" id="exifSection" style="display:none;">
                        <label>EXIF Bilgileri</label>
                        <div class="exif-grid" id="exifGrid"></div>
                    </div>

                    <div class="link-group">
                        <label>Kısa Bağlantı</label>
                        <div class="link-row">
                            <input type="text" id="shortLink" readonly>
                            <button class="btn-copy" data-target="shortLink">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>Doğrudan Bağlantı</label>
                        <div class="link-row">
                            <input type="text" id="directLink" readonly>
                            <button class="btn-copy" data-target="directLink">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>HTML Kodu</label>
                        <div class="link-row">
                            <input type="text" id="htmlCode" readonly>
                            <button class="btn-copy" data-target="htmlCode">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>BBCode (Forum)</label>
                        <div class="link-row">
                            <input type="text" id="bbCode" readonly>
                            <button class="btn-copy" data-target="bbCode">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>Markdown</label>
                        <div class="link-row">
                            <input type="text" id="markdownCode" readonly>
                            <button class="btn-copy" data-target="markdownCode">Kopyala</button>
                        </div>
                    </div>

                    <div class="description-section">
                        <label>Açıklama Ekle</label>
                        <textarea id="descriptionInput" placeholder="Resim hakkında kısa bir açıklama..." maxlength="1000"></textarea>
                        <button type="button" class="btn-sm-primary" id="saveDescription">Açıklamayı Kaydet</button>
                        <span class="desc-saved" id="descSaved" style="display:none;">✓ Kaydedildi</span>
                    </div>

                    <div class="share-section">
                        <label>Paylaş</label>
                        <div class="share-buttons">
                            <button class="share-btn twitter" data-platform="twitter" title="Twitter'da paylaş">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                            </button>
                            <button class="share-btn whatsapp" data-platform="whatsapp" title="WhatsApp'ta paylaş">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                </svg>
                            </button>
                            <button class="share-btn facebook" data-platform="facebook" title="Facebook'ta paylaş">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            </button>
                            <button class="share-btn telegram" data-platform="telegram" title="Telegram'da paylaş">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18 1.897-.962 6.502-1.359 8.627-.168.9-.5 1.201-.82 1.23-.697.064-1.226-.46-1.901-.903-1.056-.692-1.653-1.123-2.678-1.799-1.185-.781-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.062 3.345-.479.329-.913.489-1.302.481-.428-.009-1.252-.242-1.865-.441-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.831-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635.099-.002.321.023.465.138.121.096.154.228.17.32.016.124.036.33.02.511z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <p class="delete-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <a id="deleteLink" href="#" target="_blank">Resmi Sil</a>
                    </p>
                </div>
            </div>

            <button type="button" class="btn-secondary" id="newUploadBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Yeni Resim Yükle
            </button>
        </div>

        <% if (recentUploads.length > 0) { %>
        <div class="recent-section">
            <h3>Son Yüklenenler</h3>
            <div class="recent-grid">
                <% recentUploads.forEach(function(img) { %>
                <a href="<%= img.shortUrl %>" class="recent-item <%= nsfwFlags.get(img.key) ? 'nsfw-blur' : '' %>">
                    <img src="<%= img.url %>" alt="<%= img.originalName %>" loading="lazy">
                    <span class="file-badge" style="background:<%= (img.mimeType === 'image/gif' ? '#22c55e' : img.mimeType === 'image/png' ? '#f59e0b' : '#6366f1') %>">
                        <%= (img.mimeType === 'image/gif' ? 'GIF' : img.mimeType === 'image/png' ? 'PNG' : 'JPG') %>
                    </span>
                    <% if (nsfwFlags.get(img.key)) { %>
                    <span class="nsfw-badge">+18</span>
                    <% } %>
                </a>
                <% }); %>
            </div>
            <a href="/gallery" class="view-all-link">Tümünü Gör →</a>
        </div>
        <% } %>

        <footer class="footer">
            <p>Güvenli altyapı</p>
            <div class="footer-badges">
                <span>Cloudflare R2</span>
                <span>Render</span>
            </div>
        </footer>

    </main>

    <script src="/js/app.js"></script>
</body>
</html>
