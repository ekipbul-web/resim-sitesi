<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="description" content="ImgFast - Ücretsiz, hızlı ve güvenli resim yükleme. Anında paylaşım linkleri.">
    <meta name="theme-color" content="#09090b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="stylesheet" href="/css/style.css">
    <title>ImgFast - Hızlı Resim Yükleme</title>
</head>
<body>

    <main class="main-container">
        
        <!-- ========== HEADER ========== -->
        <header class="header">
            <div class="logo">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect width="40" height="40" rx="12" fill="url(#logoGrad)"/>
                    <path d="M12 26V14L20 20L28 14V26C28 27.1046 27.1046 28 26 28H14C12.8954 28 12 27.1046 12 26Z" fill="white" fill-opacity="0.9"/>
                    <circle cx="20" cy="14" r="4" fill="white" fill-opacity="0.9"/>
                    <defs>
                        <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40">
                            <stop stop-color="#6366f1"/>
                            <stop offset="1" stop-color="#8b5cf6"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <h1>Img<span>Fast</span></h1>
            <p class="tagline">Sürükle, bırak, paylaş</p>
        </header>

        <!-- ========== UPLOAD CARD ========== -->
        <div class="upload-card">
            
            <!-- Drop Zone -->
            <div class="upload-zone" id="dropZone">
                <div class="icon-wrapper">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <h3>Resim Yüklemek İçin Dokun</h3>
                <p>veya <span>dosya seç</span> · Max <%= Math.round(maxFileSize / 1048576) %> MB</p>
            </div>

            <!-- Hidden Input -->
            <input type="file" id="fileInput" accept="image/*">

            <!-- Preview -->
            <div class="preview-area" id="previewArea">
                <img id="previewImg" src="" alt="Önizleme">
                <div class="preview-bar">
                    <span id="previewInfo"></span>
                    <button type="button" class="btn-text" id="removeBtn">Kaldır</button>
                </div>
            </div>

            <!-- Upload Button -->
            <button type="button" class="btn-primary" id="uploadBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
                </svg>
                Yükle
            </button>

            <!-- Loading -->
            <div class="loading-area" id="loadingArea">
                <div class="loader"></div>
                <p>Resim yükleniyor...</p>
            </div>

            <!-- Error -->
            <div class="error-area" id="errorArea"></div>
        </div>

        <!-- ========== RESULT CARD ========== -->
        <div class="result-area" id="resultArea">
            <div class="result-card">
                <img id="resultImg" src="" alt="Yüklenen resim">
                <div class="result-body">
                    <h4>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Yükleme Başarılı
                    </h4>
                    
                    <div class="link-group">
                        <label>Doğrudan Bağlantı</label>
                        <div class="link-row">
                            <input type="text" id="directLink" readonly>
                            <button class="btn-copy" data-target="directLink">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>HTML Kodu</label>
                        <div class="link-row">
                            <input type="text" id="htmlCode" readonly>
                            <button class="btn-copy" data-target="htmlCode">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>BBCode (Forum)</label>
                        <div class="link-row">
                            <input type="text" id="bbCode" readonly>
                            <button class="btn-copy" data-target="bbCode">Kopyala</button>
                        </div>
                    </div>

                    <div class="link-group">
                        <label>Markdown</label>
                        <div class="link-row">
                            <input type="text" id="markdownCode" readonly>
                            <button class="btn-copy" data-target="markdownCode">Kopyala</button>
                        </div>
                    </div>

                    <p class="delete-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        Silme bağlantısı: <a id="deleteLink" href="#" target="_blank">Resmi Sil</a>
                    </p>
                </div>
            </div>

            <button type="button" class="btn-secondary" id="newUploadBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Yeni Resim Yükle
            </button>
        </div>

        <!-- ========== FOOTER ========== -->
        <footer class="footer">
            <p>Güvenli altyapı</p>
            <div class="footer-badges">
                <span>Cloudflare R2</span>
                <span>Render</span>
            </div>
        </footer>

    </main>

    <script src="/js/app.js"></script>
</body>
</html>
