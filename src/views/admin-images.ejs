<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <link rel="icon" type="image/png" href="/logo.png">
    <title>ImgFast - Admin - Tüm Resimler</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #09090b;
            color: #f4f4f9;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 240px;
            background: #121216;
            border-right: 1px solid #27272d;
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 10;
        }
        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 32px;
            padding: 0 8px;
        }
        .sidebar-logo img {
            width: 32px;
            height: 32px;
            border-radius: 8px;
        }
        .sidebar-logo span {
            background: linear-gradient(135deg, #6366f1, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .sidebar-menu {
            list-style: none;
        }
        .sidebar-menu li {
            margin-bottom: 4px;
        }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            color: #a1a1aa;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .sidebar-menu a:hover,
        .sidebar-menu a.active {
            background: #1a1a20;
            color: #f4f4f9;
        }
        .sidebar-menu a.active {
            color: #6366f1;
        }
        .sidebar-footer {
            position: absolute;
            bottom: 16px;
            left: 16px;
            right: 16px;
        }
        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            color: #ef4444;
            text-decoration: none;
            font-size: 0.8rem;
        }
        .sidebar-footer a:hover {
            background: rgba(239,68,68,0.1);
        }
        .main-content {
            margin-left: 240px;
            padding: 24px 32px;
        }
        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 24px;
        }
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .page-info {
            font-size: 0.85rem;
            color: #71717a;
        }
        .table-container {
            background: #121216;
            border: 1px solid #27272d;
            border-radius: 14px;
            overflow: hidden;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th,
        td {
            padding: 12px 16px;
            text-align: left;
            font-size: 0.8rem;
        }
        th {
            background: #0d0d11;
            color: #71717a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.7rem;
        }
        td {
            border-top: 1px solid #1a1a20;
            color: #a1a1aa;
        }
        tr:hover td {
            background: #1a1a20;
        }
        .badge {
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
        }
        .badge-info {
            background: rgba(99,102,241,0.15);
            color: #6366f1;
        }
        .badge-danger {
            background: rgba(239,68,68,0.15);
            color: #ef4444;
        }
        .badge-success {
            background: rgba(34,197,94,0.15);
            color: #22c55e;
        }
        .btn-sm {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn-sm-danger {
            background: rgba(239,68,68,0.15);
            color: #ef4444;
        }
        .btn-sm-warning {
            background: rgba(245,158,11,0.15);
            color: #f59e0b;
        }
        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }
        .pagination a,
        .pagination span {
            padding: 8px 14px;
            border-radius: 8px;
            background: #121216;
            border: 1px solid #27272d;
            color: #a1a1aa;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .pagination a:hover {
            background: #1a1a20;
        }
        .pagination span.current {
            background: #6366f1;
            color: #fff;
            border-color: #6366f1;
        }
        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }
            .main-content {
                margin-left: 0;
                padding: 16px;
            }
            table {
                font-size: 0.7rem;
            }
            th,
            td {
                padding: 8px;
            }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="/logo.png" alt="ImgFast">
            <span>Admin</span>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/admin">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Dashboard
                </a>
            </li>
            <li>
                <a href="/admin/images" class="active">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    Tüm Resimler
                </a>
            </li>
            <li>
                <a href="<%= siteUrl %>" target="_blank">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    Siteyi Gör
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/admin/logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Çıkış Yap
            </a>
        </div>
    </aside>

    <main class="main-content">
        <h1 class="page-title">🖼️ Tüm Resimler</h1>

        <div class="top-bar">
            <span class="page-info">
                Toplam <%= images.length %> resim | Sayfa <%= currentPage %> / <%= totalPages || 1 %>
            </span>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Resim</th>
                        <th>Dosya Adı</th>
                        <th>Görüntülenme</th>
                        <th>Yorum</th>
                        <th>NSFW</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (images.length === 0) { %>
                    <tr>
                        <td colspan="7" style="text-align:center;padding:40px;color:#71717a;">Henüz resim yüklenmemiş.</td>
                    </tr>
                    <% } %>
                    <% images.forEach(function(img) { %>
                    <tr>
                        <td>
                            <a href="<%= img.shortUrl %>" target="_blank">
                                <img src="<%= img.url %>" alt="<%= img.originalName %>" style="width:40px;height:40px;object-fit:cover;border-radius:6px;">
                            </a>
                        </td>
                        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= img.originalName %>">
                            <%= img.originalName %>
                        </td>
                        <td>
                            <span class="badge badge-info"><%= viewCounts.get(img.key) || 0 %></span>
                        </td>
                        <td>
                            <span class="badge badge-success"><%= (comments.get(img.key) || []).length %></span>
                        </td>
                        <td>
                            <% if (nsfwFlags.get(img.key)) { %>
                            <span class="badge badge-danger">+18</span>
                            <% } else { %>
                            <span style="color:#484f58;">-</span>
                            <% } %>
                        </td>
                        <td><%= new Date(img.uploadedAt).toLocaleDateString('tr-TR') %></td>
                        <td>
                            <a href="/admin/nsfw/<%= img.key %>" class="btn-sm btn-sm-warning">
                                <%= nsfwFlags.get(img.key) ? 'NSFW Kaldır' : '+18 İşaretle' %>
                            </a>
                            <a href="/admin/delete/<%= img.key %>" class="btn-sm btn-sm-danger" onclick="return confirm('Bu resmi silmek istediğinize emin misiniz? Bu işlem geri alınamaz!')">Sil</a>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
            <a href="/admin/images?page=<%= currentPage - 1 %>">← Önceki</a>
            <% } %>
            
            <% for (var i = 1; i <= totalPages; i++) { %>
                <% if (i === currentPage) { %>
                <span class="current"><%= i %></span>
                <% } else { %>
                <a href="/admin/images?page=<%= i %>"><%= i %></a>
                <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
            <a href="/admin/images?page=<%= currentPage + 1 %>">Sonraki →</a>
            <% } %>
        </div>
        <% } %>

    </main>

</body>
</html>
