<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <meta property="og:image" content="<%= imageUrl %>">
    <meta property="og:title" content="ImgFast - Resim">
    <meta property="og:description" content="<%= views %> görüntülenme">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= imageUrl %>">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>ImgFast - Resim · <%= views %> görüntülenme</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #09090b;
            color: #f4f4f9;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 16px;
            -webkit-font-smoothing: antialiased;
        }
        .image-wrapper {
            max-width: 100%;
            max-height: 75vh;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
            background: #000;
        }
        .image-wrapper img {
            max-width: 100%;
            max-height: 75vh;
            display: block;
            object-fit: contain;
        }
        .info-bar {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 16px;
            font-size: 0.85rem;
            color: #a1a1aa;
        }
        .info-bar .views {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .btn {
            padding: 10px 20px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.875rem;
            transition: opacity 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            border: none;
            cursor: pointer;
        }
        .btn:active { opacity: 0.7; }
        .btn-primary { background: #6366f1; color: #fff; }
        .btn-outline { background: transparent; border: 1px solid #27272d; color: #a1a1aa; }
        .btn-danger { background: transparent; border: 1px solid #ef4444; color: #ef4444; }
        footer {
            margin-top: 24px;
            font-size: 0.75rem;
            color: #484f58;
            text-align: center;
        }
        footer a { color: #6366f1; text-decoration: none; }
    </style>
</head>
<body>
    
    <div class="image-wrapper">
        <img src="<%= imageUrl %>" alt="ImgFast Resim">
    </div>

    <div class="info-bar">
        <span class="views">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
            <%= views %> görüntülenme
        </span>
    </div>

    <div class="actions">
        <a href="<%= imageUrl %>" download class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            İndir
        </a>
        <a href="<%= siteUrl %>" class="btn btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Yeni Yükle
        </a>
        <a href="<%= deleteUrl %>" class="btn btn-danger" onclick="return confirm('Resmi silmek istediğinize emin misiniz?')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
            </svg>
            Sil
        </a>
    </div>

    <footer>
        <a href="<%= siteUrl %>">ImgFast</a> ile yüklendi
    </footer>

</body>
</html>
