<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <meta property="og:image" content="<%= imageUrl %>">
    <meta property="og:title" content="ImgFast - Resim">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= imageUrl %>">
    <title>ImgFast - Resim</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #09090b;
            color: #f4f4f9;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .image-container {
            max-width: 100%;
            max-height: 80vh;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
        }
        .image-container img {
            max-width: 100%;
            max-height: 80vh;
            display: block;
            object-fit: contain;
        }
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .btn {
            padding: 10px 20px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.875rem;
            transition: opacity 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn:active { opacity: 0.7; }
        .btn-primary { background: #6366f1; color: #fff; }
        .btn-outline { background: transparent; border: 1px solid #27272d; color: #a1a1aa; }
        footer { margin-top: 20px; font-size: 0.75rem; color: #484f58; }
        footer a { color: #6366f1; text-decoration: none; }
    </style>
</head>
<body>
    <div class="image-container">
        <img src="<%= imageUrl %>" alt="ImgFast Resim">
    </div>
    <div class="actions">
        <a href="<%= imageUrl %>" download class="btn btn-primary">
            ⬇ İndir
        </a>
        <a href="<%= siteUrl %>" class="btn btn-outline">
            📸 Yeni Yükle
        </a>
    </div>
    <footer>
        <a href="<%= siteUrl %>">ImgFast</a> ile yüklendi
    </footer>
</body>
</html>
