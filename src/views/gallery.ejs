<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="description" content="ImgFast - Son yüklenen resimler galerisi">
    <meta name="theme-color" content="#09090b">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="stylesheet" href="/css/style.css">
    <title>ImgFast - Galeri</title>
</head>
<body>

    <button class="theme-toggle" id="themeToggle" aria-label="Tema değiştir">
        <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
    </button>

    <main class="main-container">
        
        <header class="header">
            <a href="/" style="text-decoration:none;color:inherit;">
                <div class="logo">
                    <img src="/logo.png" alt="ImgFast" width="48" height="48" style="border-radius:12px;">
                </div>
                <h1>Img<span>Fast</span></h1>
            </a>
            <p class="tagline">Resim Galerisi</p>
        </header>

        <div class="gallery-controls">
            <form class="search-form" method="GET" action="/gallery">
                <input type="text" name="search" placeholder="Resim ara..." value="<%= search %>" class="search-input">
                <button type="submit" class="search-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
                <% if (search) { %>
                <a href="/gallery" class="clear-search">✕</a>
                <% } %>
            </form>

            <div class="sort-buttons">
                <a href="/gallery?sort=newest<%= search ? '&search=' + search : '' %>" class="sort-btn <%= sort === 'newest' ? 'active' : '' %>">En Yeni</a>
                <a href="/gallery?sort=popular<%= search ? '&search=' + search : '' %>" class="sort-btn <%= sort === 'popular' ? 'active' : '' %>">Popüler</a>
                <a href="/gallery?sort=oldest<%= search ? '&search=' + search : '' %>" class="sort-btn <%= sort === 'oldest' ? 'active' : '' %>">En Eski</a>
                <a href="/gallery?sort=name<%= search ? '&search=' + search : '' %>" class="sort-btn <%= sort === 'name' ? 'active' : '' %>">İsim</a>
            </div>
        </div>

        <% if (images.length === 0) { %>
        <div style="text-align:center;padding:40px 20px;color:var(--text-muted);">
            <p style="font-size:1.2rem;margin-bottom:8px;">🔍</p>
            <p>Resim bulunamadı.</p>
            <a href="/gallery" style="color:var(--primary);">Tümünü göster</a>
        </div>
        <% } else { %>
        <div class="gallery-grid" id="galleryGrid">
            <% images.forEach(function(img) { %>
            <a href="<%= img.shortUrl %>" class="gallery-item <%= nsfwFlags.get(img.key) ? 'nsfw-blur' : '' %>">
                <img src="<%= img.url %>" alt="<%= img.originalName %>" loading="lazy">
                <div class="gallery-item-overlay">
                    <span class="gallery-item-badge" style="background:<%= getFileTypeBadge(img.mimeType).color %>">
                        <%= getFileTypeBadge(img.mimeType).label %>
                    </span>
                    <span class="gallery-item-views">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <%= viewCounts.get(img.key) || 0 %>
                    </span>
                </div>
                <div class="gallery-item-info">
                    <span class="gallery-item-name"><%= img.originalName %></span>
                </div>
                <% if (nsfwFlags.get(img.key)) { %>
                <span class="nsfw-badge">+18</span>
                <% } %>
            </a>
            <% }); %>
        </div>
        <% } %>

        <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
            <a href="/gallery?page=<%= currentPage - 1 %><%= sort !== 'newest' ? '&sort=' + sort : '' %><%= search ? '&search=' + search : '' %>">← Önceki</a>
            <% } %>
            
            <% for (var i = 1; i <= totalPages; i++) { %>
                <% if (i === currentPage) { %>
                <span class="current"><%= i %></span>
                <% } else { %>
                <a href="/gallery?page=<%= i %><%= sort !== 'newest' ? '&sort=' + sort : '' %><%= search ? '&search=' + search : '' %>"><%= i %></a>
                <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
            <a href="/gallery?page=<%= currentPage + 1 %><%= sort !== 'newest' ? '&sort=' + sort : '' %><%= search ? '&search=' + search : '' %>">Sonraki →</a>
            <% } %>
        </div>
        <% } %>

        <div style="text-align:center;margin-top:24px;">
            <a href="/" class="btn-secondary" style="display:inline-flex;text-decoration:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <polyline points="19 12 12 19 5 12"/>
                </svg>
                Yeni Resim Yükle
            </a>
        </div>

    </main>

    <script src="/js/app.js"></script>
</body>
</html>
