<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="description" content="ImgFast - Son yüklenen resimler galerisi">
    <meta name="theme-color" content="#09090b">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/style.css">
    <title>ImgFast - Galeri</title>
</head>
<body>

    <button class="theme-toggle" id="themeToggle" aria-label="Tema değiştir">
        <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
    </button>

    <main class="main-container">
        
        <header class="header">
            <a href="/" style="text-decoration:none;color:inherit;">
                <div class="logo">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <rect width="40" height="40" rx="12" fill="url(#logoGrad)"/>
                        <path d="M12 26V14L20 20L28 14V26C28 27.1046 27.1046 28 26 28H14C12.8954 28 12 27.1046 12 26Z" fill="white" fill-opacity="0.9"/>
                        <circle cx="20" cy="14" r="4" fill="white" fill-opacity="0.9"/>
                        <defs>
                            <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40">
                                <stop stop-color="#6366f1"/>
                                <stop offset="1" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <h1>Img<span>Fast</span></h1>
            </a>
            <p class="tagline">Son Yüklenen Resimler</p>
        </header>

        <% if (recentUploads.length === 0) { %>
            <div style="text-align:center;padding:40px 20px;color:var(--text-muted);">
                <p>Henüz resim yüklenmemiş.</p>
                <a href="/" style="color:var(--primary);">İlk resmi sen yükle!</a>
            </div>
        <% } else { %>
            <div class="gallery-grid">
                <% recentUploads.forEach(function(img) { %>
                <a href="<%= img.shortUrl %>" class="gallery-item">
                    <img src="<%= img.url %>" alt="<%= img.originalName %>" loading="lazy">
                    <div class="gallery-item-info">
                        <span class="gallery-item-name"><%= img.originalName %></span>
                    </div>
                </a>
                <% }); %>
            </div>
        <% } %>

        <div style="text-align:center;margin-top:24px;">
            <a href="/" class="btn-secondary" style="display:inline-flex;text-decoration:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <polyline points="19 12 12 19 5 12"/>
                </svg>
                Yeni Resim Yükle
            </a>
        </div>

    </main>

    <script>
        // Tema değiştirme
        var themeToggle = document.getElementById('themeToggle');
        var savedTheme = localStorage.getItem('imgfast-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);

        themeToggle.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('imgfast-theme', next);
        });
    </script>

</body>
</html>
