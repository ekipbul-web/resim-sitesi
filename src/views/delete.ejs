<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <title>ImgFast - <%= success ? 'Silindi' : 'Hata' %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
            background: #09090b;
            color: #f4f4f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            min-height: 100dvh;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }
        .card {
            background: #121216;
            border: 1px solid #27272d;
            border-radius: 18px;
            padding: 36px 28px;
            text-align: center;
            max-width: 400px;
            width: 100%;
        }
        .icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 1.5rem;
        }
        .success .icon { background: rgba(34,197,94,0.1); color: #22c55e; }
        .error .icon { background: rgba(239,68,68,0.1); color: #ef4444; }
        h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; }
        p { color: #a1a1aa; font-size: 0.875rem; margin-bottom: 20px; }
        a {
            display: inline-block;
            padding: 12px 24px;
            background: #6366f1;
            color: #fff;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.875rem;
            transition: opacity 0.2s;
        }
        a:active { opacity: 0.8; }
    </style>
</head>
<body class="<%= success ? 'success' : 'error' %>">
    <div class="card">
        <div class="icon"><%= success ? '✓' : '✕' %></div>
        <h2><%= message %></h2>
        <% if (success) { %>
            <p>Dosya Cloudflare R2 sunucularından kalıcı olarak kaldırıldı.</p>
        <% } %>
        <a href="/">Ana Sayfaya Dön</a>
    </div>
</body>
</html>
